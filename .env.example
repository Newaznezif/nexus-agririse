# Copy to .env.local for development. Values are deliberately empty: never commit a real key.
#
# Browser-visible. `NEXT_PUBLIC_*` is inlined into client code at build time, so anything
# placed here is public. Only the two Supabase values below belong in this group — the anon key
# is RLS-scoped and safe to publish; the service-role key is not.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server only. Bypasses row-level security: must never appear in NEXT_PUBLIC_*, browser code,
# logs, API responses, or a committed file. Needed for the data sync and any admin write.
SUPABASE_SERVICE_ROLE_KEY=

# Server only. Bearer token that authorizes POST /api/data/sync. Minimum 16 characters; if it
# is unset the sync endpoint refuses every request, which is the intended default.
# Generate one:  openssl rand -base64 32
SYNC_SECRET=

# Optional. The AI insight feature reads this exact name (services/ai.ts); the data dashboard
# works without it. Server only. There is no OPENAI_* variable in this codebase.
GEMINI_API_KEY=

# Scheduler side, not read by the app. Where scripts/run-sync.mjs sends its POST; defaults to
# http://localhost:3000 when unset. Pair it with SYNC_SECRET in the cron/CI environment, which
# is the only place both values exist together.
SYNC_URL=

# Scripts side, not read by the app. Base URL for scripts/check-data-routes.mjs and
# scripts/show-live-sample.mjs when testing a running server.
BASE=
